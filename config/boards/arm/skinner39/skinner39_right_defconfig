# SPDX-License-Identifier: MIT

CONFIG_INPUT=y
CONFIG_ZMK_MOUSE=y
CONFIG_PMW3610=y
CONFIG_PMW3610_INVERT_X=n
CONFIG_PMW3610_INVERT_Y=y
# 2026-06-10: 旧ファームは右=n だった（カクつきの一因の可能性）。y に変更。
# トラックボールの挙動がおかしければ n に戻す
# 2026-10-30: Seaside39（使いやすい実機）に合わせて n を試す
CONFIG_PMW3610_SMART_ALGORITHM=n
# 2026-06-12: badjeff ドライバに戻したため CPI は dts（cpi = <1200>）で設定。Kconfig の CPI は存在しない

CONFIG_ZMK_EXT_POWER=y
CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_SKINNER39_RIGHT=y

CONFIG_LOG_PROCESS_THREAD_STARTUP_DELAY_MS=4000
CONFIG_ZMK_DISPLAY=y
CONFIG_SPI=y
# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y

# 2026-06-10: Windows再接続フリーズ対策（PHY 2M無効・実証済み）。v0.3系でも維持
CONFIG_BT_CTLR_PHY_2M=n

# 2026-10-25: 左と同じく deep sleep を明示的に切る（放置フリーズの切り分け）
CONFIG_ZMK_SLEEP=n

# 2026-10-28: config/trackball_settings.conf はボード名不一致でビルドに入っていなかった。
# その中で今のドライバ（badjeff@e3b4a7a）が受け付ける省電力の2項目だけをここへ移す。
# CPI は dts（cpi = <1200>）、POLLING_RATE_400_SW と RGBLED_WIDGET はこのドライバ/構成に無い項目なので入れない
# 動かし始めてから3.2秒は全速のまま（既定128ms）。少し止めてから動かしたときの引っかかりを減らす
CONFIG_PMW3610_RUN_DOWNSHIFT_TIME_MS=3264
# 休みに入った直後の見回り間隔を短く（既定40ms）。動かし始めの反応を速く
CONFIG_PMW3610_REST1_SAMPLE_TIME_MS=20

# 2026-10-30: 既定0＝動くたびに即報告し、BLE の接続間隔（7.5〜15ms）より速くて mouse report の送信待ち（20個）が詰まる。
# 8ms ごとに足し合わせて1回送る（Seaside39 の POLLING_RATE_125_SW と同じ間隔）
CONFIG_PMW3610_REPORT_INTERVAL_MIN=8

# 2026-10-30: 親（PC とつながる側）の送信出力を最大に（既定 0dBm → +8dBm）。職場の混雑・イヤホン併用時の安定用。
# 6月に「固まる件」には効かないとして外したが、つながりやすさ目的では未試行。右の電池は少し早く減る
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
