# 2026-10-28: central を右（トラックボール側・Seaside39 と同じ）に変更。変えるのは central 役だけ
# （v0.3・badjeff ドライバ・SLEEP=n・PHY_2M=n はそのまま）。トラックボールは右でローカル処理（BLE relay なし）。
# 履歴: 2026-06-12 に左central に戻した（6月は v0.3化・ドライバ・central を同時に変えたので原因未切り分け）。
if BOARD_SKINNER39_RIGHT

config ZMK_KEYBOARD_NAME
	default "SKINNER39"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif # BOARD_SKINNER39_RIGHT

if BOARD_SKINNER39_LEFT || BOARD_SKINNER39_RIGHT

config ZMK_SPLIT
	default y

config BT_CTLR
	default BT

if USB

config USB_NRFX
	default y

config USB_DEVICE_STACK
	default y

endif # USB

if LVGL

config ZMK_DISPLAY_DEDICATED_THREAD_STACK_SIZE
	default 8192

config LV_Z_VDB_SIZE
	default 64

config LV_DPI_DEF
	default 148

config LV_Z_BITS_PER_PIXEL
	default 1

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

config I2C
	default y

config SPI
	default y

endif # BOARD_SKINNER39_LEFT || BOARD_SKINNER39_RIGHT
